# Copy to .env and fill in ONE provider's key. Never commit .env.
# Built and tested on Groq's free tier: 1,000 requests/day, 8,000 tokens/minute.

GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Other providers work with no code change — set LLM_PROVIDER and LLM_MODEL:
#   OPENAI_API_KEY=         LLM_PROVIDER=openai      LLM_MODEL=gpt-4o-mini
#   GEMINI_API_KEY=         LLM_PROVIDER=gemini      LLM_MODEL=gemini-3.5-flash-lite
#   ANTHROPIC_API_KEY=      LLM_PROVIDER=anthropic   LLM_MODEL=claude-3-5-haiku-20241022
#   OPENROUTER_API_KEY=     LLM_PROVIDER=openrouter
